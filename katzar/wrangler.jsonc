{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "katzar",
	"main": "./src/worker.ts",
	"d1_databases": [{ "binding": "DB", "database_name": "katzar", "database_id": "7113a80a-ce1e-467c-98db-1a030b9e1c75" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "katzar-media" }],
	"durable_objects": { "bindings": [{ "name": "ROOM_TIMER", "class_name": "RoomTimer" }] },
	"migrations": [{ "tag": "room-timer-v1", "new_sqlite_classes": ["RoomTimer"] }],
	"triggers": { "crons": ["* * * * *"] },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
