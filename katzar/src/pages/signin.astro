---
import Base from '../layouts/Base.astro';
---
<Base title="Sign in" page="signin"><section class="auth shell"><p class="eyebrow">WELCOME BACK</p><h1>Sign in</h1><p>Your session lasts 23 hours.</p>
  <form id="auth-form"><label>Username<input name="username" autocomplete="username" required /></label><label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
    <button class="button primary" type="submit">Sign in</button><p class="form-status" role="status"></p></form><p>New here? <a href="/signup">Create an account</a></p></section></Base>
