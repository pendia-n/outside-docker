---
import Base from '../../layouts/Base.astro';
export const prerender=false;
---
<Base title="One-person invitation" page="invite"><section class="auth shell"><p class="eyebrow">PRIVATE INVITATION</p><h1>Someone invited you.</h1><p>This link can be claimed by one signed-in person. Only accept if you trust the person who sent it.</p><p id="invite-details" class="muted">Checking invitation…</p><button id="accept-invite" class="button primary" hidden>Accept invitation</button><p id="invite-status" role="status"></p></section></Base>
