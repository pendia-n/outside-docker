{
  "name": "sol-app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-transform-types --experimental-loader ./scripts/ts-resolver.mjs --test src/*.test.ts",
    "build:contract": "node ./scripts/build-contract.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build:contract && pnpm run build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "hono": "^4.13.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "solc": "^0.8.36",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.6.1",
    "wrangler": "^4.110.0"
  }
}
